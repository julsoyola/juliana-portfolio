# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/portfolio/node_modules
/portfolio/.pnp
.pnp.*
portfolio/.yarn/*
!portfolio/.yarn/patches
!portfolio/.yarn/plugins
!portfolio/.yarn/releases
!portfolio/.yarn/versions

# testing
/portfolio/coverage

# next.js
/portfolio/.next/
/portfolio/out/

# production
/portfolio/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# Ensure compiled PDFs in public are tracked
!portfolio/public/resumes/*.pdf

# Local-only UX resume
/resumes/JulianaOyolaUX.tex
/resumes/JulianaOyolaUX.pdf
/portfolio/public/resumes/JulianaOyolaUX.pdf
